# TPI Metodologia — example environment (placeholders only, NO secrets).
# Copy to .env and fill in real values. .env is gitignored and never committed.
# Canonical dev/test databases are provisioned by docker-compose.yml (db service).

# Async SQLAlchemy URL used by the API (dev database on the Compose service).
DATABASE_URL=postgresql+asyncpg://tpi:tpi@localhost:5433/tpi_dev
# Isolated database used ONLY by the pytest harness (same service, other DB).
TEST_DATABASE_URL=postgresql+asyncpg://tpi:tpi@localhost:5433/tpi_test
# App secret (replace with a long random value in real .env files).
SECRET_KEY=change-me-in-your-local-env

# --- Auth token lifetimes (C-02). Optional: defaults shown below. ---
# Access token lifetime in minutes (1..1440).
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days (1..90).
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Operator bootstrap (C-02, design D8) ---
# Optional: initial admin password for `python -m app.cli.bootstrap_clinic`.
# Leave empty to be prompted with hidden input; never commit a real value.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Optional integrations (not required to boot; C-05/C-08) ---
WHATSAPP_API_TOKEN=
AFIP_CERT_PATH=
AFIP_CUIT=

# --- docker-compose.yml parity (POSTGRES_* feed the db service) ---
POSTGRES_USER=tpi
POSTGRES_PASSWORD=tpi
POSTGRES_DB=tpi_dev
POSTGRES_TEST_DB=tpi_test
